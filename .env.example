# qlink-server 环境变量配置
# 复制此文件为 .env 并填写实际值

# ===================================================
# 通用
# ===================================================

# 服务监听端口（按服务区分，见各服务章节）
# account=8001, data=8002, link=8003, shop=8005, ai=8006, gateway=8888
PORT=8001

# 服务注册主机名（用于服务注册中心展示，默认 localhost）
HOST=localhost

# JWT 密钥（account/data/link/shop 服务启动会校验，必须配置非默认值）
JWT_SECRET=

# ===================================================
# MySQL
# ===================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# 数据库密码（Go 服务连接用；同时作为 mysql 容器的 root 密码）
MYSQL_PWD=root
# mysql 容器 root 密码（docker-compose 通过 ${MYSQL_ROOT_PASSWORD} 注入）
MYSQL_ROOT_PASSWORD=root

# ===================================================
# Redis
# ===================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PWD=

# streamer 服务使用合并地址形式
REDIS_ADDR=localhost:6379

# ===================================================
# RabbitMQ
# 本地直连（go run 用）：使用宿主机地址 localhost
# docker-compose 会用下方账号密码自动拼出容器内部地址 amqp://user:pass@rabbitmq:5672/
# ===================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# RabbitMQ 容器默认账号密码（docker-compose 通过 ${RABBITMQ_DEFAULT_USER/PASS} 注入容器）
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ===================================================
# Kafka
# ===================================================
KAFKA_BROKERS=localhost:9092

# ===================================================
# ClickHouse
# ===================================================
CLICKHOUSE_ADDR=localhost:8123
CLICKHOUSE_USER=qlink
CLICKHOUSE_PWD=
CLICKHOUSE_DB=qlink_analytics

# ===================================================
# MinIO / 对象存储
# ===================================================
# STORAGE_TYPE: local 或 minio（docker-compose 中 account 服务强制为 minio）
STORAGE_TYPE=local
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=aqicloud-link
# MinIO 访问密钥（Go 服务连接用；同时作为 minio 容器的 root 凭据）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# minio 容器 root 账号密码（docker-compose 通过 ${MINIO_ROOT_USER/PASSWORD} 注入容器）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 公网/局域网可访问地址：替换为部署机的实际 IP（docker-compose 已用 ${MINIO_PUBLIC_URL} 引用）
# 注意：跨机器部署必须改成对应机器 IP，否则上传/访问文件会失败
MINIO_PUBLIC_URL=http://<your-server-ip>:9010/aqicloud
MINIO_USE_SSL=false

# 本地存储（STORAGE_TYPE=local 时生效）
UPLOAD_PATH=/data/uploads
UPLOAD_URL=

# ===================================================
# 服务间调用地址
# ===================================================
LINK_SERVICE=http://localhost:8003
DATA_SERVICE=http://localhost:8002
ACCOUNT_SERVICE=http://localhost:8001
SHOP_SERVICE=http://localhost:8005
AI_SERVICE=http://localhost:8006

# ===================================================
# 安全 / RPC
# ===================================================
# RPC 内部调用令牌（已有 ValidateRPCToken 检查，保留默认占位）
RPC_TOKEN=rpc-token-default

# ===================================================
# SMS 短信服务
# ===================================================
# SMS_PROVIDER: log / alibaba / tencent
SMS_PROVIDER=log
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=AqiCloud
SMS_APP_ID=
SMS_SECRET_ID=
SMS_SECRET_KEY=

# ===================================================
# AI 服务（internal/ai/config 加载）
# ===================================================
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3.5:9b

# ===================================================
# 高德地图（streamer 服务用于 IP 地理位置解析）
# ===================================================
AMAP_API_KEY=

# 时区（streamer 服务日期格式化使用）
TZ=Asia/Shanghai

# ===================================================
# OAuth 登录（可选，account 服务通过 internal/account/config 加载）
# ===================================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_WECHAT_APP_ID=
OAUTH_WECHAT_APP_SECRET=

# ===================================================
# 支付（shop 服务通过 internal/shop/component 加载）
# ===================================================
WECHAT_PAY_ENV=sandbox
ALI_APP_ID=
ALI_PRIVATE_KEY=
ALI_PUBLIC_KEY=
ALI_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALI_NOTIFY_URL=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
